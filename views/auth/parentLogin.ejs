<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Parent Login</title>
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <link rel="stylesheet" href="/css/auth/coordinatorLogin.css">
</head>

<body>

    <form action="/request-otp" method="POST">
        <div class="login-card">
            <div class="login-title">Parent Login</div>

            <div class="input-group">
                <label>Parent Number</label>
                <input
                    type="tel"
                    name="parentNumber"
                    placeholder="Enter registered number"
                    inputmode="numeric"
                    maxlength="10"
                    pattern="[6-9][0-9]{9}"
                    oninput="allowOnlyNumbers(this)"
                    required
                    title="Enter a valid 10-digit Indian mobile number starting with 6-9"
                >
            </div>

            <button class="login-btn" type="submit">Send OTP</button>

            <p class="error-message">
                <%= msg %>
            </p>

            <a href="/" class="text-decoration-none">Back to home</a>
        </div>
    </form>

     <script>
        function allowOnlyNumbers(input) {
            input.value = input.value.replace(/\D/g, '');
        }
    </script>
</body>
</html>
